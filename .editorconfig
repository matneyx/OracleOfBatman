# See docs/STYLE.md for what this can and can't enforce — it's an editor
# hint, not a lint. rustfmt/clippy (Rust) and oxlint (TS) are the real
# enforcement for the files they cover; this fills the gap for everything
# else (YAML, TOML, Markdown, Dockerfiles).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false # trailing double-space is a Markdown line break
