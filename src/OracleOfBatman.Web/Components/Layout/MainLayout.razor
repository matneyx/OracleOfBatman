@inherits LayoutComponentBase

<MudThemeProvider Theme="GothamTheme.Theme" IsDarkMode="true"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout Class="gotham-layout">
  <MudAppBar Elevation="0" Dense="true" Class="gotham-appbar">
    <MudText Typo="Typo.h6" Class="gotham-wordmark">Oracle of Batman</MudText>
  </MudAppBar>
  <MudMainContent>
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
      @Body
    </MudContainer>
  </MudMainContent>
</MudLayout>
