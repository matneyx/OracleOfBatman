@using OracleOfBatman.Domain
<div class="entity-chip" data-testid="@($"issue-card-{Issue.ComicVineId}")">
  <MudAvatar Square="true" Class="entity-chip__avatar entity-chip__cover" data-testid="issue-avatar">
    <MudImage Src="@Issue.ImageUrl" Alt="@Issue.ToDisplayName()" ObjectFit="ObjectFit.Cover"/>
  </MudAvatar>
  <div class="entity-chip__name" data-testid="issue-name">
    @if (Issue.SiteDetailUrl is null or "")
    {
      <MudText Typo="Typo.body2">@Issue.ToDisplayName()</MudText>
    }
    else
    {
      <MudLink Href="@Issue.SiteDetailUrl" Typo="Typo.body2" Color="Color.Inherit" Underline="Underline.Hover"
               Target="_blank">@Issue.ToDisplayName()</MudLink>
    }
  </div>
</div>

@code {

  [Parameter]
  [EditorRequired]
  public required Issue Issue { get; set; }

}
