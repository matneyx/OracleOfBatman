@using OracleOfBatman.Domain
<MudCard data-testid="@($"issue-card-{Issue.ComicVineId}")">
  <MudCardContent>
    <MudGrid Spacing="1">
      <MudItem sm="4">
        <MudAvatar Square Variant="Variant.Outlined" Size="Size.Large" Class="rounded"
                   data-testid="@("issue-avatar")">
          <MudImage Src="@Issue.ImageUrl"/>
        </MudAvatar>
      </MudItem>
      <MudItem sm="8" data-testid="@("issue-name")">
        @if (Issue.SiteDetailUrl is null or "")
        {
          <MudText Typo="Typo.h5">@Issue.ToDisplayName()</MudText>
        }
        else
        {
          <MudLink Href="@Issue.SiteDetailUrl" Typo="Typo.h5" Target="_blank">@Issue.ToDisplayName()</MudLink>
        }
      </MudItem>
    </MudGrid>
  </MudCardContent>
</MudCard>

@code {

  [Parameter]
  [EditorRequired]
  public required Issue Issue { get; set; }

}
