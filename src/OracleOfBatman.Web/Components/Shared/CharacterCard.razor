@using OracleOfBatman.Domain
<div class="entity-chip" data-testid="@($"character-card-{Character.ComicVineId}")">
  <MudAvatar Size="Size.Large" Class="entity-chip__avatar" data-testid="character-avatar">
    <MudImage Src="@Character.ImageUrl" Alt="@Character.Name" ObjectFit="ObjectFit.Cover"/>
  </MudAvatar>
  <div class="entity-chip__name" data-testid="character-name">
    @if (Character.SiteDetailUrl is null or "")
    {
      <MudText Typo="Typo.body1">@Character.Name</MudText>
    }
    else
    {
      <MudLink Href="@Character.SiteDetailUrl" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.Hover"
               Target="_blank">@Character.Name</MudLink>
    }
  </div>
</div>

@code {

  [Parameter]
  [EditorRequired]
  public required Character Character { get; set; }

}
